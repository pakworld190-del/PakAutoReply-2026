<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_provider"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose AI service provider to power auto-replies:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Radio Group for Multi-Providers in preferred order -->
    <RadioGroup
        android:id="@+id/rg_providers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rb_gemini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Gemini (Google AI Studio)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_openai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="ChatGPT / OpenAI"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_grok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Grok / xAI"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Meta AI / Llama"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_elevenlabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="ElevenLabs (Voice / Agents)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rb_lowlevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Local AI / Low-Level (لو لیول - Ollama)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_provider_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_provider_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_emerald"
            android:paddingHorizontal="20dp"
            android:text="SELECT"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
